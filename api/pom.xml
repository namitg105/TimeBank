<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.timebank</groupId>
  <artifactId>timebank-api</artifactId>
  <version>1.0</version>
  <name>TimeBank REST API</name>
  <description>
    Thin HTTP layer over the JDBC DAOs. Flutter cannot speak to Oracle
    directly because there is no Oracle driver for Dart, so this service
    is the bridge: it receives JSON, runs the real JDBC calls, and
    returns JSON. The database work happens here.
  </description>

  <properties>
    <java.version>21</java.version>

    <!--
      WHY THIS PROPERTY IS HERE.

      The spring-boot-starter-parent above brings in a bill of materials
      that already pins a version for every library Spring Boot knows
      about, the Oracle driver included.  Boot 3.3.5 pins it at 21.9.0.0.

      That version will not work here.  From 21c onwards Oracle's thin
      driver dropped support for databases older than 12.1, and this
      project runs on XE 11g (11.2.0.2).  The 19c line is the last one
      that still connects to it.

      Overriding the pin with a <version> tag on each dependency works,
      but the IDE then warns "Overrides version defined in
      DependencyManagement".  Setting the property Boot itself uses
      changes the MANAGED version instead, so the dependencies below
      inherit 19.23.0.0 cleanly, every Oracle artifact stays on the same
      line, and the warning goes away.
    -->
    <oracle-database.version>19.23.0.0</oracle-database.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Oracle's own JDBC driver, thin mode: pure Java, no Oracle Instant
      Client to install.  ucp is Oracle's Universal Connection Pool.

      Both take their version from oracle-database.version above.
    -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ucp</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>timebank-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
